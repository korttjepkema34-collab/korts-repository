# Copy to server/.env and fill in. Never commit server/.env.

# Tailscale IP of this server. Services bind here so they are reachable only on the tailnet.
SERVER_TS_IP=100.x.y.z

# Redis
REDIS_PASSWORD=change-me-to-something-long
REDIS_HOST=127.0.0.1

# LLM endpoint the orchestrator talks to. Ollama's OpenAI-compatible API by default.
# Point at a paid provider only for escalation; see docs/04-models.md.
LLM_BASE_URL=http://127.0.0.1:11434/v1   # native Ollama on Windows; http://ollama:11434/v1 for the docker profile
LLM_API_KEY=ollama
ORCHESTRATOR_MODEL=qwen3.6:35b-a3b          # verified tag, ~20 GB, MoE
REVIEWER_MODEL=qwen3-vl:8b                # verified tag, 6.1 GB, vision

# Gaming PC, for wake-on-LAN. MAC of its wired adapter, and the LAN broadcast address.
GPU_MAC=AA:BB:CC:DD:EE:FF
LAN_BROADCAST=192.168.1.255
GPU_WORKER_NAME=gpu

# How long the worker heartbeat can be missing (with jobs queued) before we send a wake packet.
WAKE_AFTER_MINUTES=5

# Windows server: path to the Godot 4 executable for headless test runs.
GODOT_BIN=C:\Godot\Godot_v4.3-stable_win64.exe

# Model slots. Everything local and free. Unattended runs do not care about latency, so the
# escalation model can be the biggest thing that fits in 96 GB RAM (slow but smarter).
CODER_MODEL=qwen3.6:35b-a3b-coding        # verified tag; alternative qwen3-coder:30b (19 GB)
ESCALATION_MODEL=gpt-oss:120b             # ~65 GB mxfp4; gpt-oss:20b (13 GB) if RAM is tight

# Unattended-run rails
MAX_INFLIGHT_JOBS=12
MAX_CODER_RUNS_PER_TASK=3
MAX_GENERATED_TASKS_PER_DAY=10
STALE_JOB_SECONDS=5400
MIN_FREE_GB=20
LOOP_SECONDS=20

# Self-improvement (docs/15-training.md). Traces are always recorded; training is opt-in.
# AUTO_TRAIN=1 lets the daily pass queue a `train` job for the GPU worker when enough new data exists.
AUTO_TRAIN=0
AUTO_TRAIN_MIN_IMAGES=40          # approved images before the first SDXL style LoRA
AUTO_TRAIN_IMAGE_GROWTH=20        # new approved images before a retrain
AUTO_TRAIN_MIN_CODER_PASSES=150   # gate-passed coder runs before the first coder fine-tune
AUTO_TRAIN_CODER_GROWTH=75
AUTO_TRAIN_MIN_OVERRIDES=100      # your own verdicts (scripts/override.py) before the reviewer fine-tune
AUTO_TRAIN_OVERRIDE_GROWTH=50
TRAIN_STALE_SECONDS=43200         # a training job may run 12 h before the orchestrator gives up on it (worker kills it 10 min earlier)
EMBED_MODEL=nomic-embed-text      # retrieval index for the coder (scripts/build_rag_index.py)

# Fine-tuned models served from another machine (set by scripts/activate_model.py instructions).
# Leave empty to use LLM_BASE_URL for everything.
CODER_BASE_URL=
REVIEWER_BASE_URL=

# Optional: a Godot MCP server for editor tools in the coder loop. Leave empty to skip.
# Example (Coding-Solo godot-mcp): GODOT_MCP_CMD=node C:\tools\godot-mcp\build\index.js
GODOT_MCP_CMD=

# Escalate all code jobs to ESCALATION_MODEL after the same failure class repeats this many times within the window.
FAIL_SIG_THRESHOLD=3
FAIL_SIG_WINDOW_S=86400

# Coder on the gaming PC's GPU when it is online (Ollama there, bound to its Tailscale IP).
# The 3080 Ti runs a dense 27B coder far better than the CPU MoE; the worker pauses image jobs
# while the coder holds the GPU (Redis key gpu:llm_lock). Leave empty to keep the coder on the CPU.
CODER_BASE_URL_GPU=
CODER_MODEL_GPU=qwen3.6:27b

# Nightly playtest (dedicated server + two bots + vision report + bug tasks) and Windows build. 1 = on.
PLAYTEST_DAILY=1
BUILD_DAILY=1

# Safety nets (docs/23-safety-nets.md)
# Commands the loop may run to restart a dependency that has been unreachable for 2 minutes (at most once per 10 min).
OLLAMA_START_CMD=powershell -Command "Start-Process ollama -ArgumentList serve -WindowStyle Hidden"
REDIS_START_CMD=docker compose -f C:\studio\server\docker-compose.yml up -d redis
# The engineer may fix the studio's own code behind the test gate; the supervisor rolls back a bad fix. 1 = on.
ENGINEER_ENABLED=1
# Optional push notifications (free): make a topic at https://ntfy.sh and subscribe in the app.
NOTIFY_URL=

# Free cloud escalation (docs/24-cloud-escalation.md). Rungs are tried in order; a rung that errors or
# hits its daily cap is skipped for an hour; the local ESCALATION_MODEL is always last. Only escalated
# work uses this: deferred retries, repeated failure classes, the engineer, planning repair.
#   ollama:<model>-cloud   needs `ollama signin` on the server (free tier: GPU-time quota, resets in sessions)
#   openrouter:<id>:free   needs OPENROUTER_API_KEY (50 requests/day free; 1000/day after buying $10 once)
ESCALATION_LADDER=ollama:qwen3-coder:480b-cloud,ollama:gpt-oss:120b-cloud,openrouter:qwen/qwen3-coder:free,openrouter:deepseek/deepseek-chat-v3.1:free
OPENROUTER_API_KEY=
OPENROUTER_DAILY_CAP=40
OLLAMA_CLOUD_DAILY_CAP=60
LADDER_COOLDOWN_S=3600
# Cloud vision for the judgements that matter most (playtest reports, proof runs); local reviewer otherwise.
VISION_LADDER=openrouter:qwen/qwen2.5-vl-72b-instruct:free

# Rarely changed
REDIS_PORT=6379
# REPO_ROOT is set by run-orchestrator.ps1 / studio.ps1; GODOT_DOCS_DIR defaults to server/godot-docs;
# OPENROUTER_BASE_URL defaults to https://openrouter.ai/api/v1.
