# secrets and per-machine config
server/.env
worker/config.yaml
worker/GAMING_MODE

# generated assets are synced with Syncthing, not git
assets/**
!assets/README.md
!assets/*/
!assets/*/.gitkeep
!assets/training/
!assets/training/*/
!assets/training/*/.gitkeep

# training data captured by the studio (traces, retrieval index, fetched docs, cloned repos)
data/**
!data/README.md
worker/workflows/*.bak

# python
__pycache__/
*.pyc
.venv/

# godot
game/.godot/
game/export/
*.import.tmp

# os
.DS_Store
Thumbs.db

# redis snapshots from local testing
dump.rdb

# Godot class reference dump (regenerate with scripts/dump_godot_docs)
server/godot-docs/

# nightly builds and playtest captures
builds/*
!builds/.gitkeep
reports/playtests/
reports/proofs/
reports/screenshots/

RESTART_REQUESTED
reports/health.json
reports/last_good.txt
incidents/.index.json
.pytest_cache/


# Assistant runtime and private knowledge never belong in this public repository
.assistant-local/
assistant/config.local.json
assistant/workers.local.json
**/.obsidian/workspace*.json
**/state.sqlite*
**/runner.lock
